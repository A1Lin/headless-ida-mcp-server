IDA_PATH=/home/ubuntu/idapro-9.0/idat
PORT=8888
HOST=0.0.0.0
TRANSPORT=sse
# TRANSPORT=stdio

# ── multi-session worker configuration ──
# concurrent worker limit (only non-DEAD sessions count; each worker holds the
# whole database in memory, typically GB-scale)
MAX_SESSIONS=8
# DEAD session records (tombstones) kept for list_sessions history and
# restart_session; older ones are pruned. -1 keeps them forever.
DEAD_SESSION_RETENTION=4

# Open timeout is SIZE-AWARE by default (bigger binary → disproportionately
# longer auto-analysis):
#   raw binary: BASE + PER_MB * MB ** POWER   (defaults: 120 + 6*MB^1.5)
#     1 MB→~2 min, 10 MB→~5 min, 100 MB→~1.7 h, capped at MAX (24 h)
#   .i64/.idb:  BASE + PER_MB * MB            (already analyzed: load only)
# Leave OPEN_TIMEOUT unset (or 0) for the formula; set it to a positive number
# of seconds for a flat override.
#OPEN_TIMEOUT=600
#OPEN_TIMEOUT_BASE=120
#OPEN_TIMEOUT_PER_MB=6
#OPEN_TIMEOUT_POWER=1.5
#OPEN_TIMEOUT_MAX=86400

# protocol single-line limit, bytes (default 256MB — huge responses such as
# list_functions on big binaries exceed the asyncio default of 64KB)
MAX_RESPONSE_BYTES=268435456

# There are intentionally no CALL_TIMEOUT / SAVE_TIMEOUT values: analysis ops
# (decompile of huge functions, list_functions) and GB-scale database saves
# legitimately run for many minutes and a fixed bound would kill them
# half-way. Recovery from a genuinely hung worker is close_session /
# restart_session (SIGTERM → SIGKILL escalation), or killing the pid shown by
# list_sessions.
